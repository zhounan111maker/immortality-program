# ============================================================
#  永生计划 · 研究纲领平台 — 依赖安装配置
# ------------------------------------------------------------
#  这个文件会随仓库提交，本地与 Vercel 都读取它，
#  因此两处的依赖布局完全一致，构建结果可复现。
# ============================================================

# 使用「扁平」依赖布局（与 npm 相同的 node_modules 结构），
# 而不是 pnpm 默认的符号链接布局。
#
# 为什么这样选：
#   1. 可复现 —— 本地与 Vercel 用同一套布局，不会出现
#      「本机好好的、CI 上找不到模块」这类差异。
#   2. 兼容性 —— 某些工具（含部分原生绑定的解析路径）在
#      符号链接布局下会解析失败。扁平布局没有这个问题。
node-linker=hoisted

# ============================================================
#  ⚠ 不要在这里添加 npm 镜像源
# ------------------------------------------------------------
#  例如不要写：
#      registry=https://registry.npmmirror.com
#
#  原因：Vercel 的构建机器在境外。镜像源可能导致
#        ERR_PNPM_TARBALL_INTEGRITY（pnpm 把校验和不匹配视为硬错误），
#        构建会直接失败。
#
#  镜像属于「你这台机器」的设置，请写在用户级配置里：
#      C:\Users\<你的用户名>\.npmrc
#  它自动对所有项目生效，而且不会跟着代码进仓库。
#
#  详见 docs/零基础部署指南.md 的 .npmrc 专章。
# ============================================================
